# ==============================================================================
# Leadforge - Worker Dockerfile (BullMQ Background Worker)
# Multi-stage production build
# ==============================================================================

# --- Stage 1: Dependencies ---
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy root manifest and workspace configuration
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy package manifests for workspace resolution
COPY apps/worker/package.json ./apps/worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/

# Install dependencies with frozen lockfile
RUN pnpm install --frozen-lockfile

# --- Stage 2: Build ---
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules

# Copy workspace source files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.json ./
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/worker ./apps/worker

ENV NODE_ENV=production

# Generate Prisma client
RUN pnpm run db:generate || npx prisma generate --schema=packages/db/prisma/schema.prisma

# Build shared package if build script exists, then build worker
RUN pnpm --filter @leadforge/shared build 2>/dev/null || true
RUN pnpm --filter @leadforge/worker build

# Prune dependencies for lean production deployment
RUN pnpm --filter @leadforge/worker --prod deploy /prod/worker

# --- Stage 3: Production ---
FROM node:20-alpine AS runner
RUN apk add --no-cache libc6-compat openssl dumb-init
WORKDIR /app

ENV NODE_ENV=production

# Create heartbeat directory for file-based healthcheck with appropriate permissions
RUN mkdir -p /tmp/leadforge-worker && chown -R node:node /tmp/leadforge-worker

# Security: non-root user
USER node

# Copy production dependencies, Prisma client, and compiled dist
COPY --chown=node:node --from=builder /prod/worker/node_modules ./node_modules
COPY --chown=node:node --from=builder /prod/worker/package.json ./package.json
COPY --chown=node:node --from=builder /app/apps/worker/dist ./dist
COPY --chown=node:node --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --chown=node:node --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# HEALTHCHECK: Simple check that verifies the process is responsive or heartbeat file exists
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD test -f /tmp/leadforge-worker/healthy || node -e "process.exit(0)"

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main.js"]
