# === Database ===
DATABASE_URL="postgresql://leadforge:CHANGE_ME_dev_only@localhost:5432/leadforge?schema=public" # PostgreSQL connection string

# === Redis ===  
REDIS_URL="redis://localhost:6379" # Redis connection string

# === Auth ===
JWT_SECRET="CHANGE_ME_minimum_32_characters_long_random_string_here" # Min 32 bytes, used for JWT signing
JWT_ACCESS_EXPIRY="15m" # Access token expiry
JWT_REFRESH_EXPIRY="7d" # Refresh token expiry

# === App ===
NODE_ENV="development"
API_PORT=4000
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000" # Comma-separated allowed origins

# === OpenAI ===
OPENAI_API_KEY="sk-CHANGE_ME_fake_key_here" # OpenAI API key
OPENAI_MODEL="gpt-4o" # Default model
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# === Gmail OAuth ===
GMAIL_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="CHANGE_ME_gmail_secret"
GMAIL_REDIRECT_URI="http://localhost:4000/api/v1/communications/gmail/callback"

# === WhatsApp (Feature Flagged) ===
WHATSAPP_ENABLED="false"
WHATSAPP_VERIFY_TOKEN="CHANGE_ME_whatsapp_verify"
WHATSAPP_APP_SECRET="CHANGE_ME_whatsapp_secret"
WHATSAPP_ACCESS_TOKEN="CHANGE_ME_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME"

# === n8n ===
N8N_WEBHOOK_SECRET="CHANGE_ME_n8n_webhook_secret" # HMAC secret for n8n webhook signing
N8N_API_URL="http://localhost:5678"
N8N_API_KEY="CHANGE_ME_n8n_api_key"

# === Encryption ===
ENCRYPTION_KEY="CHANGE_ME_32_byte_hex_encoded_key_here_64chars" # AES-256-GCM key for token encryption

# === File Storage ===
STORAGE_TYPE="local" # 'local' or 's3'
S3_BUCKET="leadforge-uploads-dev"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"

# === Billing (Feature Flagged) ===
BILLING_ENABLED="false"
RAZORPAY_KEY_ID="rzp_test_CHANGE_ME"
RAZORPAY_KEY_SECRET="CHANGE_ME"

# === Cloudflare Turnstile ===
TURNSTILE_SECRET_KEY="CHANGE_ME_turnstile_secret"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="CHANGE_ME_turnstile_site_key" # Only public key

# === Email (Dev) ===
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="noreply@example.com"
